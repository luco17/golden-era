---
import AppStore from "../components/AppStore.astro";
---

<dialog
  x-ref="aboutDialog"
  x-effect="showAbout ? $refs.aboutDialog.showModal() : $refs.aboutDialog.close()"
  @close="showAbout = false"
  @click.self="showAbout = false"
  class="w-screen h-screen max-w-none max-h-none bg-transparent p-0 m-0"
>
  <div
    class="relative w-full h-full overflow-y-auto bg-[#446196] py-8 px-4 md:p-8 rounded-t-xl text-[#EFE5D4] shadow-xl"
  >
    {/* Slideover header + menu */}
    <div class="flex items-center justify-between">
      <h1 class="text-4xl md:text-6xl xl:text-7xl font-title pl-1">About</h1>
      <div class="flex h-8 items-center">
        <button
          type="button"
          class="relative rounded-full bg-white/20 text-[#EFE5D4] hover:text-gray-500 focus:ring-2 focus:ring-indigo-500"
          @click="showAbout = false"
        >
          <span class="absolute -inset-2.5"></span>
          <span class="sr-only">Close panel</span>
          <svg
            class="h-7 w-7"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
    {/* Slideover text */}
    <div class="space-y-2 mt-4 font-sans md:text-xl xl:text-2xl max-w-3xl">
      <p>
        The 70s were the 'Golden Era' of bodybuilding. Watch 'Pumping Iron' or
        'Arnold' and you'll be struck by how good the athletes looked.
      </p>
      <p>
        Imagine training when there was no texting in the racks, no scrolling
        insta, no selfies... just working out and forging friendships and
        rivalries.
      </p>
      <p>
        Inspired by the era's aesthetic we've created a repository of workouts
        from some of these legendary figures. If you want to track your
        progress or share sessions with your buddies you should check out our
        training diary app, <strong
          ><a href="https://seshin.squaddy.app" class="text-orange-500">Seshin</a
          ></strong
        >, it helps keep you accountable.
      </p>
      <div class="py-4 flex items-center space-x-3 justify-start">
        <a
          href="https://apps.apple.com/gb/app/seshin-workout-tracker/id6749040439?uo=2"
        >
          <AppStore />
        </a>
      </div>
      <p>We hope you enjoy this throwback to simpler times!</p>
      <p>
        <em>
          p.s. please don't try these workouts if you don't know what you're
          doing. The volumes are high!
        </em>
      </p>
    </div>
  </div>
</dialog>

<style>
  dialog::backdrop {
    background-color: rgb(31 41 55 / 0.1);
    backdrop-filter: blur(4px);
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  dialog[open] {
    animation: slideUp 0.3s ease-out;
  }
</style>

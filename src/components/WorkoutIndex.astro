<dialog
  x-ref="workoutDialog"
  x-effect="showWorkoutIndex ? $refs.workoutDialog.showModal() : $refs.workoutDialog.close()"
  @close="showWorkoutIndex = false"
  @click.self="showWorkoutIndex = false"
  class="max-w-screen-2xl w-full top-0 bg-transparent p-0 m-0"
>
  <div
    class="relative space-y-2 w-full max-h-[85vh] overflow-y-auto rounded-b-xl bg-[#C85325] py-4 px-1 md:p-4"
  >
    <div class="flex items-center justify-between">
      <h1
        class="text-4xl md:text-6xl xl:text-7xl font-title pl-1 text-[#EFE5D4]"
      >
        Index
      </h1>
      <div class="flex h-8 items-center">
        <button
          type="button"
          class="relative rounded-full bg-white/20 text-[#EFE5D4] hover:text-gray-500 focus:ring-2 focus:ring-indigo-500"
          @click="showWorkoutIndex = false"
        >
          <span class="absolute -inset-2.5"></span>
          <span class="sr-only">Close panel</span>
          <svg
            class="h-7 w-7"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
    <!-- Loop through workout titles -->
    <div class="flex flex-row flex-wrap space-x-2">
      <template
        x-for="(workout, index) in $store.workoutStore.workouts"
        :key="index"
      >
        <button
          type="button"
          class="rounded border-2 font-sans border-yellow-400 px-3 py-2 text-sm sm:text-lg text-[#FAF8F2] font-medium shadow-sm hover:bg-indigo-500 mb-2"
          x-on:click="showWorkoutIndex = false; $store.workoutStore.activeWorkout = index"
          x-text="workout.title"></button>
      </template>
    </div>
  </div>
</dialog>

<style>
  dialog::backdrop {
    background-color: rgb(31 41 55 / 0.2);
    backdrop-filter: blur(4px);
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  dialog[open] {
    animation: slideDown 0.3s ease-out;
  }
</style>
